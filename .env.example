# Copy this file to .env and fill in your own values.
# See SETUP.md for step-by-step instructions on getting each one.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The ID of your Google Sheet (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# Google service account credentials.
# Easiest: paste the ENTIRE contents of the service-account JSON key file as one line here.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Port the server runs on locally (Render sets its own PORT automatically)
PORT=3000

# Optional. Free API key from https://www.pexels.com/api/ used to fetch a
# real photo for AI-invented recipes (which don't come with one). If you
# leave this blank, those recipes just show a food emoji instead — nothing
# breaks either way.
PEXELS_API_KEY=
